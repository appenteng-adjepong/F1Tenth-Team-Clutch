	// 			"ms-python.debugpy"
	// 		]
	// 	}
	// },
	
	"shutdownAction": "none",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-iot.vscode-ros"
			]
		}
	}

	// Configure tool-specific properties.
